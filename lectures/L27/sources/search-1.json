          "journal": {
            "medlineAbbreviation": "J Comp Physiol A Neuroethol Sens Neural Behav Physiol",
            "title": "Journal of comparative physiology. A, Neuroethology, sensory, neural, and behavioral physiology",
            "essn": "1432-1351",
